generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LlmStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  APPOINTMENT_REMINDER
  CANCELLATION
  POST_VISIT_SUMMARY
  MEDICATION_REMINDER
}

enum NotificationChannel {
  EMAIL
  CALENDAR
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient?
  doctor  Doctor?
}

model Patient {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime?
  bloodGroup  String?
  allergies   String?

  appointments Appointment[]
}

model Doctor {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String
  bio            String?
  // slot duration in minutes, e.g. 30
  slotDuration   Int     @default(30)
  // JSON: { "mon": { "start": "09:00", "end": "17:00" }, "tue": null, ... }
  workingHours   Json    @default("{}")
  // encrypted OAuth tokens for Google Calendar; null until doctor connects calendar
  calendarTokens Json?

  leaves       DoctorLeave[]
  appointments Appointment[]
}

model DoctorLeave {
  id       String   @id @default(uuid())
  doctorId String
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  reason   String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)

  // symptom form
  symptoms String?

  // LLM pre-visit summary — stored as JSON: { urgency, chiefComplaint, suggestedQuestions }
  preVisitSummary Json?
  preVisitLlmStatus LlmStatus @default(PENDING)

  // doctor post-visit
  postVisitNotes String?
  prescriptions  Json?   // [{ medication, dose, frequency, days }]

  // LLM post-visit — patient-friendly text
  postVisitSummary    String?
  postVisitLlmStatus  LlmStatus @default(SKIPPED)

  // Google Calendar event IDs (one per side)
  calendarEventIdPatient String?
  calendarEventIdDoctor  String?

  // last reminder sent (to avoid duplicate reminders)
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications NotificationLog[]

  // No @@unique here — cancelled appointments must not block rebooking the same slot.
  // Concurrency is handled by pg_advisory_xact_lock in appointmentService.
}

model NotificationLog {
  id            String              @id @default(uuid())
  appointmentId String
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          NotificationType
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  attempt       Int                 @default(0)
  lastAttemptAt DateTime?
  error         String?
  createdAt     DateTime            @default(now())
}
